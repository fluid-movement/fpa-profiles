# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# fpa-api, where players are looked up (default http://localhost:3000)
FPA_API_URL="http://localhost:3000"
# fpa-api's REFRESH_TOKEN; when set, saving a profile triggers an fpa-api refresh
FPA_API_REFRESH_TOKEN=""
