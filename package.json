{
	"name": "fpa-profiles",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
		"users": "node --env-file-if-exists=.env scripts/users.ts",
		"start": "node scripts/migrate.ts && node build",
		"import:legacy": "node --env-file-if-exists=.env scripts/import-legacy.ts"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.55.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"auth": "^1.6.24",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"playwright": "^1.60.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"better-auth": "^1.7.7",
		"drizzle-orm": "^0.45.4",
		"postgres": "^3.4.9",
		"valibot": "^1.5.0"
	},
	"packageManager": "pnpm@12.11.2"
}
